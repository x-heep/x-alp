[run]
branch = True
source = .
omit =
    tests/*
    .claude/*
    .agents/*
    .codex/*
    */__pycache__/*

[report]
show_missing = True
skip_empty = True
# Mako compiles rendered templates (e.g. in pytest tmp dirs) into modules
# that have no python source to report on.
ignore_errors = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
