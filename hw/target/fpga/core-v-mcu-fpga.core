name: x-heep:x-alp:core-v-mcu-fpga
description: CORE-V MINI-MCU FPGA related files.

filesets:
  rtl-fpga:
#    depend:
#    - x-heep:x-alp:packages
    files:
    - sram_wrapper.sv
    file_type: systemVerilogSource

  ip-fpga:
    files:
    - scripts/generate_sram.tcl:  { file_type: tclSource }
    - prim_xilinx_clk.sv
    - pad_cell_input_xilinx.sv
    - pad_cell_output_xilinx.sv
    - pad_cell_inout_xilinx.sv
    file_type: systemVerilogSource

  ip-fpga-aup-zu3:
    files:
    - scripts/aup-zu3/xilinx_generate_clk_wizard.tcl
    file_type: tclSource
    
  xdc-fpga-aup-zu3:
    files:
    - constraints/aup-zu3/pin_assign.xdc
    - constraints/aup-zu3/constraints.xdc
    - constraints/common/spi_slave.xdc
    - constraints/common/jtag.xdc
    - constraints/common/sync.xdc
    file_type: xdc
  
  xdc-fpga-genesys2:
    files:
    - constraints/genesys2/pin_assign.xdc
    - constraints/genesys2/constraints.xdc
    - constraints/common/spi_slave.xdc
    - constraints/common/jtag.xdc
    - constraints/common/sync.xdc
    file_type: xdc

targets:
  default: &default_target
    filesets:
    - rtl-fpga
    - ip-fpga
    - target_aup-zu3 ? (xdc-fpga-aup-zu3)
    - target_aup-zu3 ? (ip-fpga-aup-zu3)
    
