`verilator_config

lint_off -rule WIDTH -file "*/rtl/pad_control_reg_top.sv" -match "Operator ASSIGNW expects *"
lint_off -rule UNUSED -file "*/rtl/pad_control_reg_top.sv" -match "Parameter is not used: 'AW'*"
